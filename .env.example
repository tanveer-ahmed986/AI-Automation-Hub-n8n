# Z&T AI Automation Hub — example environment configuration.
# Copy to `.env` and adjust. These are PLACEHOLDER VALUES ONLY — never usable
# credentials and never real secrets. Generate unique secrets per deployment.
#
# DEMO_MODE / MOCK_AI / MOCK_EMAIL default to true so the full demo path
# works with zero edits and zero paid credentials (constitution Principle IV).
# MOCK_EMAIL=true makes it structurally impossible for DEMO_MODE to send a
# real email, even if other variables are misconfigured.

APP_ENV=development
DEMO_MODE=true
MOCK_AI=true
MOCK_EMAIL=true

APP_BASE_URL=http://localhost:3000
N8N_BASE_URL=http://localhost:5678

# Override only if one of these default host ports is already in use on
# your machine (the containers always talk to each other on the standard
# ports inside the Docker network regardless of these values).
# POSTGRES_HOST_PORT=5432
# N8N_HOST_PORT=5678
# DASHBOARD_HOST_PORT=3000
N8N_ENCRYPTION_KEY=replace_with_a_long_random_secret

# No N8N_BASIC_AUTH_* here: verified live against the pinned n8n 2.43.5
# image that it no longer gates access (it ships its own user-management
# system instead). Complete the owner-account setup wizard at
# http://localhost:5678 on first run — see docs/security.md.

POSTGRES_DB=automation_hub
POSTGRES_USER=automation_user
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql://automation_user:replace_with_a_strong_password@postgres:5432/automation_hub

# n8n gets its own logical database on the same Postgres instance (created
# once by database/init/001-create-n8n-database.sh) so its internal
# credential/execution tables never mix with this app's business tables.
N8N_DB_NAME=n8n

# Shared secret n8n sends on every internal-API call (X-Internal-Api-Secret
# header). Required on every /api/internal/* request; requests without a
# matching header are rejected. Generate a long random value per deployment.
INTERNAL_API_SECRET=replace_with_a_long_random_secret

AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
REVIEWER_EMAIL=

FOLLOWUP_MAX_ATTEMPTS=2
FOLLOWUP_DELAY_HOURS=48

# Public-webhook rate limit and request-size cap (FR-007).
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_MAX_BODY_BYTES=20000

# Fallback deduplication window when no idempotency_key is supplied (FR-005).
DEDUP_WINDOW_HOURS=24
